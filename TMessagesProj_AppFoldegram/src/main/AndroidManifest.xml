<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />

    <application
        android:name="dev.foldegram.messenger.FoldegramApplication"
        android:label="@string/foldegram_app_name"
        android:icon="@mipmap/foldegram_launcher"
        android:roundIcon="@mipmap/foldegram_launcher"
        android:allowBackup="false"
        android:resizeableActivity="true"
        tools:replace="android:name,android:allowBackup">

        <activity
            android:name="org.telegram.ui.FoldegramChatWindowActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TMessages" />

        <!-- Preserve alias names used by the icon selector; every choice stays Foldegram. -->
        <activity-alias android:name="org.telegram.messenger.VintageIcon" android:icon="@mipmap/foldegram_launcher" android:roundIcon="@mipmap/foldegram_launcher" tools:replace="android:icon,android:roundIcon" />
        <activity-alias android:name="org.telegram.messenger.AquaIcon" android:icon="@mipmap/foldegram_launcher" android:roundIcon="@mipmap/foldegram_launcher" tools:replace="android:icon,android:roundIcon" />
        <activity-alias android:name="org.telegram.messenger.PremiumIcon" android:icon="@mipmap/foldegram_launcher" android:roundIcon="@mipmap/foldegram_launcher" tools:replace="android:icon,android:roundIcon" />
        <activity-alias android:name="org.telegram.messenger.TurboIcon" android:icon="@mipmap/foldegram_launcher" android:roundIcon="@mipmap/foldegram_launcher" tools:replace="android:icon,android:roundIcon" />
        <activity-alias android:name="org.telegram.messenger.NoxIcon" android:icon="@mipmap/foldegram_launcher" android:roundIcon="@mipmap/foldegram_launcher" tools:replace="android:icon,android:roundIcon" />

        <!-- Removal markers are not instantiated components. Keep them even when absent upstream. -->
        <!-- No Firebase account/configuration is provisioned for this fork. -->
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" tools:ignore="MissingClass" />
        <service android:name="com.google.firebase.components.ComponentDiscoveryService" tools:node="remove" tools:ignore="MissingClass" />
        <service android:name="com.google.firebase.messaging.FirebaseMessagingService" tools:node="remove" tools:ignore="MissingClass" />
        <receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver" tools:node="remove" tools:ignore="MissingClass" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="firebase_data_collection_default_enabled" android:value="false" />
        <meta-data android:name="com.google.android.maps.v2.API_KEY" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.wallet.api.enabled" tools:node="remove" />
    </application>
</manifest>
